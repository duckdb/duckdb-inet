# name: test/sql/inet/test_inet_functions.test
# description: Test inet type
# group: [inet]

require inet

statement ok
PRAGMA enable_verification

# host
query I
SELECT host(INET '127.0.0.1/17')
----
127.0.0.1

# we support auto-cast from string literals to inet
query I
SELECT host('127.0.0.1/17')
----
127.0.0.1

# we don't support auto-casting of VARCHAR to INET
statement error
SELECT host(a) from (values ('127.0.0.1/17')) t(a);
----
No function matches

query I
SELECT family('127.0.0.1/17');
----
4

# netmask
query I
SELECT netmask(INET '192.168.1.5/32')
----
255.255.255.255

query I
SELECT netmask(INET '192.168.1.5/24')
----
255.255.255.0/24

query I
SELECT netmask(INET '192.168.1.5/16')
----
255.255.0.0/16

query I
SELECT netmask(INET '192.168.1.5/8')
----
255.0.0.0/8

query I
SELECT netmask(INET '192.168.1.5/0')
----
0.0.0.0/0

# set_masklen
statement error
SELECT set_masklen(INET '192.168.1.5', 33)
----
Invalid netmask 33: expected a number between 0 and 32

statement error
SELECT set_masklen(INET '192.168.1.5', -1)
----
expected a number between 0 and 32

# Values above 16 bits must not wrap into a valid netmask
statement error
SELECT set_masklen(INET '192.168.1.5', 65560)
----
Invalid netmask 65560: expected a number between 0 and 32

# An INET built from a raw struct with an invalid ip_type is rejected
statement error
SELECT set_masklen({'ip_type': 0::UTINYINT, 'address': 1::HUGEINT, 'mask': 8::USMALLINT}::INET, 24)
----
Invalid IP address type

# Table inputs
statement ok
CREATE TABLE masklen_input(id INTEGER, ip INET, m INTEGER);

statement ok
INSERT INTO masklen_input VALUES (1, '10.0.0.1/8', 16), (2, '10.0.0.2', 32), (3, NULL, 24), (4, '2001:db8::5/32', 64), (5, '10.0.0.3', NULL), (6, '::1', 0);

query I
SELECT set_masklen(ip, m) FROM masklen_input ORDER BY id
----
10.0.0.1/16
10.0.0.2
NULL
2001:db8::5/64
NULL
::1/0

# network
query I
SELECT network(INET '192.168.1.5/24')
----
192.168.1.0/24

query I
SELECT network(INET '192.168.1.5/16')
----
192.168.0.0/16

# broadcast
query I
SELECT broadcast(INET '192.168.1.5/24')
----
192.168.1.255/24

query I
SELECT broadcast(INET '192.168.1.5/16')
----
192.168.255.255/16

# broadcast result should equal the equivalent directly-parsed address
query I
SELECT broadcast(INET '192.168.1.5/24') = INET '192.168.1.255/24';
----
true

# broadcast result should sort correctly
query I
SELECT broadcast(INET '192.168.1.5/24') > INET '0.0.0.1';
----
true

# broadcast of /0 should work
query I
SELECT broadcast(INET '10.0.0.1/0')
----
255.255.255.255/0

# subtract
query I
SELECT INET '127.0.0.255' - 32;
----
127.0.0.223

query I
SELECT INET '127.0.0.255' + 0;
----
127.0.0.255

query I
SELECT INET '127.0.0.31' - 32;
----
126.255.255.255

query I
SELECT INET '127.0.0.31' - -32;
----
127.0.0.63

statement error
SELECT INET '0.0.0.0' - 32;
----
Out of Range Error: Overflow in subtraction

query I
SELECT INET '255.255.255.254' + 1;
----
255.255.255.255

query I
SELECT INET '0.0.0.0' + 0;
----
0.0.0.0

statement error
select INET '255.255.255.255' + 1
----
Out of Range Error: Cannot add 1

query I
SELECT * FROM (VALUES (netmask('10.10.10.1/12')), (broadcast('10.10.10.2/8')), (network('10.10.10.3')));
----
255.240.0.0/12
10.255.255.255/8
10.10.10.3
