# name: test/sql/inet/test_arena_writes.test
# description: Arena string output lifetimes, inline boundaries, and reused validity
# group: [inet]

require inet

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE text_inputs AS
SELECT i, CASE i%8
    WHEN 0 THEN NULL
    WHEN 1 THEN repeat('a', 12)
    WHEN 2 THEN repeat('🦆', 4)
    WHEN 3 THEN '1234567890123'
    WHEN 4 THEN ''
    WHEN 5 THEN repeat('é<&"''>', 400)
    WHEN 6 THEN chr(0) || chr(13) || '&notit;'
    ELSE 'same-prefix-different-suffix-' || i::VARCHAR END AS text
FROM range(6000) t(i)

statement ok
CREATE TABLE escaped AS SELECT i, html_escape(text) AS escaped,
    html_escape(text, false) AS unquoted FROM text_inputs

query III
SELECT count(*), count(escaped), count(unquoted) FROM escaped
----
6000	5250	5250

query I
SELECT count(*) FROM escaped JOIN text_inputs USING (i)
WHERE html_unescape(escaped) IS DISTINCT FROM text OR html_unescape(unquoted) IS DISTINCT FROM text
----
0

query I
SELECT count(*) FROM escaped WHERE i%8=4 AND escaped IS NOT DISTINCT FROM ''
----
750

query TTT
SELECT html_escape(''), html_unescape(''), html_escape('é🦆&', NULL)
----
(empty)	(empty)	NULL

query I
SELECT count(*) FROM text_inputs WHERE html_escape(text, NULL) IS NOT NULL
----
0

query I
SELECT count(*) FROM text_inputs WHERE html_escape(NULL::VARCHAR) IS NOT NULL
----
0

query I
SELECT count(*) FROM (SELECT html_escape(text) FROM text_inputs WHERE false)
----
0

statement ok
CREATE TABLE formatted AS SELECT i,
    CASE i%4 WHEN 0 THEN NULL::INET WHEN 1 THEN INET '::1'
        WHEN 2 THEN INET 'ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff/127'
        ELSE INET '192.168.123.123/17' END AS ip FROM range(6000) t(i)

statement ok
CREATE TABLE formatted_strings AS SELECT i, ip::VARCHAR AS text, host(ip) AS host FROM formatted

query I
SELECT count(*) FROM formatted_strings s JOIN formatted f USING (i)
WHERE TRY_CAST(s.text AS INET) IS DISTINCT FROM f.ip OR host(TRY_CAST(s.text AS INET)) IS DISTINCT FROM s.host
----
0

query ITT
SELECT * FROM formatted_strings WHERE i IN (2046, 2047, 2048, 2049) ORDER BY i
----
2046	ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff/127	ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
2047	192.168.123.123/17	192.168.123.123
2048	NULL	NULL
2049	::1	::1

query T
SELECT TRY_CAST(ip AS VARCHAR) FROM (
    SELECT CASE i%3
        WHEN 0 THEN {'ip_type': 1::UTINYINT, 'address': 2130706433::HUGEINT, 'mask': 32::USMALLINT}
        WHEN 1 THEN {'ip_type': NULL::UTINYINT, 'address': 0::HUGEINT, 'mask': 32::USMALLINT}
        ELSE {'ip_type': 2::UTINYINT, 'address': '-170141183460469231731687303715884105727'::HUGEINT, 'mask': 128::USMALLINT}
    END::INET AS ip FROM range(6) t(i)
)
----
127.0.0.1
NULL
::1
127.0.0.1
NULL
::1
