# name: test/sql/inet/test_inet_type.test
# description: Test inet type
# group: [inet]

require inet

statement ok
PRAGMA enable_verification

query I
SELECT '127.0.0.1'::INET::VARCHAR
----
127.0.0.1

query I
SELECT '127.0.0.1/17'::INET::VARCHAR
----
127.0.0.1/17

query I
SELECT '127.0.0.1'::INET
----
127.0.0.1

query I
select '127.000.0000.1'::inet;
----
127.0.0.1

query II
SELECT INET '0.0.0.0/0', INET '255.255.255.255/31'
----
0.0.0.0/0	255.255.255.255/31

query I
SELECT typeof('127.0.0.1/17'::INET)
----
INET

statement error
select '127'::inet;
----
Conversion Error: Expected an IP address

statement error
select '127..1'::inet;
----
Conversion Error: Expected a number

statement error
SELECT '256.0.0.1'::INET::VARCHAR
----
Conversion Error: Expected a number between 0 and 255

statement error
SELECT '-1.0.0.1'::INET::VARCHAR
----
Conversion Error: Expected a number

statement error
SELECT '127..0.1'::INET::VARCHAR
----
Conversion Error: Expected a number

statement error
SELECT '127.0.0.1/33'::INET::VARCHAR
----
Conversion Error: Expected a number between 0 and 32

statement error
SELECT '127.0.0.1/333'::INET::VARCHAR
----
Conversion Error: Expected a number between 0 and 32

statement error
SELECT '127.0.0.1/33333333333333333333'::INET::VARCHAR
----
Conversion Error: Expected a number between 0 and 32

statement error
SELECT '3,786'::INET;
----
Conversion Error: Expected an IP address

statement error
SELECT '1.2.3.4#34'::INET
----
Conversion Error: Expected a slash

statement error
SELECT '999.999.999.999/24'::INET
----
Conversion Error: Expected a number between 0 and 255

statement ok
CREATE TABLE inet(ip VARCHAR);

statement ok
INSERT INTO inet VALUES ('127.0.0.1'), ('999.999.999.999/24'), ('127.0.0.1/33333333333333333333'), ('255.255.255.255/31')

query I
SELECT TRY_CAST(ip AS INET) FROM inet;
----
127.0.0.1
NULL
NULL
255.255.255.255/31

# trailing characters after the prefix are rejected
statement error
SELECT '1.2.3.4/24abc'::INET
----
Conversion Error: Unexpected extra characters

statement error
SELECT '127.0.0.1/4294967320'::INET
----
Conversion Error: Expected a number between 0 and 32

# values cast from a STRUCT are validated
statement error
SELECT host({'ip_type': 3, 'address': 0, 'mask': 0}::INET)
----
Invalid Input Error: Invalid IP address type

statement error
SELECT host({'ip_type': 1, 'address': 0, 'mask': 33}::INET)
----
Invalid Input Error: Invalid INET value
